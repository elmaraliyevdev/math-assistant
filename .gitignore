# --- Secrets & local environment ---
.env
.env.*
!.env.example
!**/.env.example
!**/.env.production.example
!release/env.production.example

# Deployment templates with placeholder values stay tracked (deploy/mvp.env, etc.)

# --- Python bytecode & virtual environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/

# --- Python tool caches & coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
*.egg-info/
.eggs/
pip-wheel-metadata/
dist/
build/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
packages/web/coverage/

# --- Local databases & runtime data ---
*.sqlite3
*.sqlite
*.db
postgres_data/

