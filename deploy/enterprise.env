# Enterprise deployment (use with: docker compose --env-file deploy/enterprise.env --profile enterprise up -d --scale simulation-worker=4)

API_DEPLOYMENT_MODE=enterprise
API_SIMULATION_EXECUTION_BACKEND=distributed
API_SIMULATION_WORKER_COUNT=4
API_SIMULATION_PROCESS_POOL_WORKERS=4
API_MAX_SIMULATION_SPIN_COUNT=100000000
API_MAX_ACTIVE_SIMULATIONS=0
API_MAX_RECOMMENDED_SPIN_COUNT=100000000
API_REDIS_URL=redis://redis:6379/0
API_JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=math_assistant

WEB_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
