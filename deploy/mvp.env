# MVP single-server deployment (use with: docker compose --env-file deploy/mvp.env --profile mvp up -d)

API_DEPLOYMENT_MODE=mvp
API_SIMULATION_EXECUTION_BACKEND=distributed
API_SIMULATION_WORKER_COUNT=1
API_SIMULATION_PROCESS_POOL_WORKERS=1
API_MAX_SIMULATION_SPIN_COUNT=10000000
API_MAX_ACTIVE_SIMULATIONS=2
API_MAX_RECOMMENDED_SPIN_COUNT=10000000
API_REDIS_URL=redis://redis:6379/0
API_JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
