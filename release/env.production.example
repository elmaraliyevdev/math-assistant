# Production environment template — Math Assistant v1.0
# Copy to .env and set values before: docker compose -f docker-compose.prod.yml up -d

# Required
API_JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=math_assistant

# API
API_SIMULATION_WORKER_COUNT=4
API_ENABLE_HSTS=false
API_METRICS_BEARER_TOKEN=
API_SENTRY_DSN=
API_SENTRY_ENVIRONMENT=production

# Ports
WEB_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
