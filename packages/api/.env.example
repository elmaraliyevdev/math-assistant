# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# PYTHONDONTWRITEBYTECODE is read by the Python interpreter at startup.
PYTHONDONTWRITEBYTECODE=1

API_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/math_assistant
API_JWT_SECRET_KEY=dev-only-change-me-in-production
API_SIMULATION_WORKER_COUNT=1
API_SIMULATION_PROCESS_POOL_WORKERS=2
